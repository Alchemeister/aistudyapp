# Client-side Firebase config (VITE_ prefix exposes to browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local development only - Gemini API key (exposed to browser in dev mode)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Server-side (Vercel only - set in Vercel Dashboard > Settings > Environment Variables)
# VITE_AI_SERVICE_KEY=your-gemini-api-key (from https://aistudio.google.com/app/apikey) - server-side only, not exposed to browser
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret (from Stripe Dashboard > Webhooks)
# FIREBASE_SERVICE_ACCOUNT=your-firebase-service-account-json
# RESEND_API_KEY=your-resend-api-key (from https://resend.com/api-keys)
# FROM_EMAIL=StudyStack <hello@yourdomain.com>
# INTERNAL_API_KEY=your-random-secret-key (for server-to-server API calls, generate with: openssl rand -hex 32)
